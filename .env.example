# SQLite DB 경로 (기본: data/finance.db)
FINANCE_DB=data/finance.db
# DART OpenAPI 인증키 (https://opendart.fss.or.kr 에서 발급). 비우면 DART 갱신은 건너뜀
# 여기에 쓰지 않고 OS 키체인에 저장해도 됨:  keyring set finance-dashboard DART_API_KEY
DART_API_KEY=
# 키체인 서비스명 (기본 finance-dashboard)
#FINANCE_KEYRING_SERVICE=finance-dashboard
# 자동 갱신 스케줄 (5필드 cron, 서버 로컬시간). 비우면 자동 갱신 안 함
REFRESH_SCHEDULE=0 6 * * *
# 서버 시작 시 즉시 한 번 갱신할지
REFRESH_ON_START=false
# DART 분기보고서(1분기·반기·3분기) 수집 여부 (기본 true). 상장사만 해당
DART_QUARTERLY=true
# 자동 갱신 후 docs/ 스냅샷을 만들어 git push (GitHub Pages 공개 페이지 자동 갱신). git 인증이 되어 있어야 함
PUBLISH_AFTER_REFRESH=false
